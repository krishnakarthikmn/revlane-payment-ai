# Copy to .env. Never commit .env.

# Database
DATABASE_URL=postgresql+psycopg://revlane:revlane@localhost:5432/revlane

# Language model. Leave LLM_API_KEY empty to run in deterministic stub mode.
# With a key and LLM_STUB=false the live client is used. LLM_MODEL defaults to
# claude-sonnet-5-5. Use a key with zero-retention terms before any real data.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_STUB=true

# Vault. "local" stores encrypted values in Postgres using VAULT_KEY (development only).
VAULT_BACKEND=local
VAULT_KEY=change-me-32-bytes-base64

# Shopper token hashing. One key per tenant is derived from this in development.
TOKEN_HASH_ROOT_KEY=change-me

# Object storage. "local" writes under ./data/objects.
STORAGE_BACKEND=local
STORAGE_PATH=./data/objects

# Agents. Set to false to stop every agent for every tenant.
AGENTS_ENABLED=true

# Carry out queued agent runs inside the API process. Leave false when a worker runs.
AGENT_RUNS_INLINE=false

# Requests one client may make in a minute, and the largest request that is not an upload.
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_MINUTE=120
MAX_BODY_BYTES=1048576

# Provider sandboxes. Leave empty to use synthetic files only.
RAZORPAY_SANDBOX_KEY_ID=
RAZORPAY_SANDBOX_KEY_SECRET=
PAYU_SANDBOX_KEY=
PAYU_SANDBOX_SALT=
PROVIDER_LIVE_CALLS=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Sign-in. Session cookies are signed with SESSION_SECRET: use a long random value
# anywhere but your own machine, and set SESSION_COOKIE_SECURE=true behind HTTPS.
SESSION_SECRET=change-me
SESSION_HOURS=12
SESSION_COOKIE_SECURE=false
# The password the two demo users are created with (at least ten characters).
# Demo users: priya.menon@acmetravel.example (admin), arjun@acmetravel.example (approver).
DEMO_USER_PASSWORD=change-me-demo-password
# A bearer token for GET /api/v1/metrics. Leave empty to switch the endpoint off.
METRICS_TOKEN=
